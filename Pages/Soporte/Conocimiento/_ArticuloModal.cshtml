@model GAS.Admin.Pages.Soporte.Conocimiento.ArticuloModalVm
@using GAS.Admin.Services.Soporte
@{
    var off = !Model.PuedeGestionar;
    var formId = Model.EsNuevo ? "form-art-nuevo" : $"form-art-{Model.Id}";
    var i = Model.Input;
}
<div data-size="xl" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon">@Iconos.Svg("note")</span>
        <div class="min-w-0">
            <h2 class="modal-title">@(Model.EsNuevo ? "Nuevo artículo" : i.Titulo)</h2>
            @if (Model.DesdeTicket is not null) { <div class="gas-modal__subtitle">Prellenado con la solución del ticket @Model.DesdeTicket. Quita datos personales del cliente antes de guardar.</div> }
            else if (!Model.EsNuevo)
            {
                <div class="gas-badges mt-2">
                    @if (i.Publicable) { <span class="gas-badge gas-badge--success">@Iconos.Svg("globe") Publicable</span> } else { <span class="gas-badge gas-badge--plain">@Iconos.Svg("lock") Interno</span> }
                    <span class="gas-badge gas-badge--plain">Usado @Model.Usos vez(es) en respuestas</span>
                    <partial name="_Trazabilidad" model="(Model.CreadoUtc, Model.CreadoPor, Model.ModificadoUtc, Model.ModificadoPor)" />
                </div>
            }
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body">
        <form id="@formId" method="post" novalidate asp-page="/Soporte/Conocimiento/Index" asp-page-handler="Guardar" asp-route-id="@Model.Id">
            <div class="row g-3">
                <div class="col-lg-8">
                    <section class="gas-card h-100">
                        <div class="gas-card__body">
                            <label class="form-label" for="@formId-titulo">Título</label>
                            <input id="@formId-titulo" name="Input.Titulo" value="@i.Titulo" class="form-control mb-3" maxlength="200" disabled="@off" placeholder="Ej. Cómo restablecer la contraseña de un usuario" />
                            <label class="form-label" for="@formId-cont">Contenido</label>
                            <textarea id="@formId-cont" name="Input.Contenido" class="form-control" rows="14" maxlength="20000" disabled="@off" placeholder="Pasos claros que se puedan copiar en una respuesta al cliente…">@i.Contenido</textarea>
                        </div>
                    </section>
                </div>
                <div class="col-lg-4">
                    <section class="gas-card h-100">
                        <div class="gas-card__body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="@formId-prod">Producto</label>
                                    <select id="@formId-prod" name="Input.ProductoId" class="form-select" disabled="@off">
                                        <option value="">General (todos)</option>
                                        @foreach (var p in Model.Productos) { <option value="@p.Id" selected="@(p.Id == i.ProductoId)">@p.Nombre</option> }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@formId-cat">Categoría</label>
                                    <select id="@formId-cat" name="Input.Categoria" class="form-select" disabled="@off">
                                        @foreach (var c in Etiquetas.Valores<CategoriaTicket>()) { <option value="@c" selected="@(c == i.Categoria)">@ServicioSoporte.TextoCategoria(c)</option> }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@formId-et">Etiquetas</label>
                                    <input id="@formId-et" name="Input.Etiquetas" value="@i.Etiquetas" class="form-control" maxlength="300" disabled="@off" placeholder="contraseña, acceso, app" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@formId-pub">Visibilidad</label>
                                    <select id="@formId-pub" name="Input.Publicable" class="form-select" disabled="@off">
                                        <option value="false" selected="@(!i.Publicable)">Solo interno</option>
                                        <option value="true" selected="@i.Publicable">Publicable para clientes</option>
                                    </select>
                                    <div class="form-text">Los publicables podrán mostrarse dentro de cada producto vía la API GAS más adelante.</div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </form>
    </div>
    <div class="modal-footer">
        @if (!Model.EsNuevo && Model.PuedeGestionar)
        {
            <form method="post" asp-page="/Soporte/Conocimiento/Index" asp-page-handler="Eliminar" asp-route-id="@Model.Id"
                  data-confirm-title="¿Eliminar el artículo?" data-confirm="Esta acción no se puede deshacer." data-confirm-ok="Eliminar" data-confirm-tone="danger">
                <button type="submit" class="btn btn-gas-danger">@Iconos.Svg("trash") Eliminar</button>
            </form>
        }
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") @(Model.PuedeGestionar ? "Cancelar" : "Cerrar")</button>
            @if (Model.PuedeGestionar) { <button type="submit" form="@formId" class="btn btn-gas">@Iconos.Svg(Model.EsNuevo ? "check" : "save") @(Model.EsNuevo ? "Crear artículo" : "Guardar cambios")</button> }
        </div>
    </div>
</div>
