@model GAS.Admin.Pages.Administracion.Usuarios.PasswordTemporalVm
<div data-size="md" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon gas-modal__icon--warning">@Iconos.Svg("key")</span>
        <div>
            <h2 class="modal-title">@(Model.EsNuevo ? "Usuario creado" : "Contraseña restablecida")</h2>
            <div class="gas-modal__subtitle">@Model.Nombre · @Model.Email</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body">
        <section class="gas-card">
            <div class="gas-card__header">
                <div>
                    <h2>@Iconos.Svg("lock") Contraseña temporal</h2>
                    <p>Solo se muestra esta vez. Deberá cambiarla al iniciar sesión.</p>
                </div>
            </div>
            <div class="gas-card__body">
                <code class="gas-secret gas-secret--lg" id="password-temporal">@Model.Password</code>
                <div class="form-text mt-3">Compártela por un canal seguro, nunca por el mismo medio que el correo.</div>
            </div>
        </section>
    </div>
    <div class="modal-footer">
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-copy="#password-temporal">@Iconos.Svg("copy") Copiar</button>
            <button type="button" class="btn btn-gas" data-bs-dismiss="modal">@Iconos.Svg("check") Listo</button>
        </div>
    </div>
</div>
