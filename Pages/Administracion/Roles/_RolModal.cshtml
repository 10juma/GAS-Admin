@model GAS.Admin.Pages.Administracion.Roles.RolModalVm
@{
    var columnas = new[] { "Ver", "Gestionar" };
    var formId = $"form-rol-{Model.Id}";
}
<div data-size="xl" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon gas-modal__icon--violet">@Iconos.Svg("shield")</span>
        <div>
            <h2 class="modal-title">
                Rol @Model.Nombre
                @if (Model.EsBase)
                {
                    <span class="gas-badge gas-badge--plain ms-1 align-middle">Base</span>
                }
            </h2>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <span class="gas-chip gas-chip--info" style="pointer-events: none;">@Iconos.Svg("users") Usuarios <span class="gas-chip__count">@Model.Usuarios</span></span>
                @if (Model.EsAdmin)
                {
                    <span class="gas-badge gas-badge--dark">Acceso total</span>
                }
                else
                {
                    <span class="gas-chip gas-chip--success" style="pointer-events: none;">@Iconos.Svg("shield") Permisos <span class="gas-chip__count" id="permisos-count">@Model.Asignados.Count</span></span>
                }
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>

    <div class="modal-body">
        @if (Model.EsAdmin)
        {
            <div class="gas-callout gas-callout--success">
                <div class="gas-callout__text">
                    <strong>Acceso total</strong>
                    El rol Admin tiene todos los permisos, incluidos los de módulos futuros. No se puede modificar.
                </div>
            </div>
        }

        <form id="@formId" method="post" asp-page="/Administracion/Roles/Index" asp-page-handler="Guardar" asp-route-id="@Model.Id">
            <section class="gas-card">
                <div class="gas-card__header">
                    <div>
                        <h2>@Iconos.Svg("layers") Permisos por módulo</h2>
                        <p>"Ver" permite consultar; "Gestionar" permite crear, editar y eliminar.</p>
                    </div>
                </div>
                <div class="gas-table-wrap">
                    <table class="gas-table gas-perm-table">
                        <thead>
                            <tr>
                                <th>Módulo</th>
                                @foreach (var c in columnas)
                                {
                                    <th class="gas-perm-cell">@c</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var modulo in Permisos.Modulos)
                            {
                                <tr>
                                    <td>
                                        <strong>@modulo.Nombre</strong>
                                        <span>@modulo.Descripcion</span>
                                    </td>
                                    @foreach (var c in columnas)
                                    {
                                        var permiso = modulo.Permisos.FirstOrDefault(p => p.Nombre == c);
                                        <td class="gas-perm-cell">
                                            @if (permiso is not null)
                                            {
                                                var marcado = Model.EsAdmin || Model.Asignados.Contains(permiso.Valor);
                                                <input type="checkbox" class="form-check-input" name="Seleccionados" value="@permiso.Valor"
                                                       checked="@marcado" disabled="@(!Model.Editable)"
                                                       aria-label="@c @modulo.Nombre" data-tipo="@c" />
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </form>
    </div>

    <div class="modal-footer">
        @if (Model.PuedeEliminar)
        {
            <form method="post" asp-page="/Administracion/Roles/Index" asp-page-handler="Eliminar" asp-route-id="@Model.Id"
                  data-confirm-title="¿Eliminar el rol @Model.Nombre?"
                  data-confirm="Esta acción no se puede deshacer."
                  data-confirm-ok="Eliminar" data-confirm-tone="danger">
                <button type="submit" class="btn btn-gas-danger">@Iconos.Svg("trash") Eliminar rol</button>
            </form>
        }
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") @(Model.Editable ? "Cancelar" : "Cerrar")</button>
            @if (Model.Editable)
            {
                <button type="submit" form="@formId" class="btn btn-gas">@Iconos.Svg("save") Guardar permisos</button>
            }
        </div>
    </div>
</div>
