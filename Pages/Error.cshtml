@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LayoutSimple";
}

<div class="gas-card" style="max-width: 560px; margin: 40px auto;">
    <div class="gas-card__body text-center" style="padding: 40px 28px;">
        @if (Model.Codigo == 404)
        {
            <h1 class="h5 mb-2" style="color: var(--gas-dark); font-weight: 700;">No encontramos lo que buscas</h1>
            <p class="mb-3" style="color: var(--gas-muted);">La página o el registro no existe, o ya fue eliminado.</p>
        }
        else if (Model.Codigo is >= 400 and < 500)
        {
            <h1 class="h5 mb-2" style="color: var(--gas-dark); font-weight: 700;">No se pudo completar la solicitud</h1>
            <p class="mb-3" style="color: var(--gas-muted);">Revisa el enlace o vuelve a intentarlo desde el menú.</p>
        }
        else
        {
            <h1 class="h5 mb-2" style="color: var(--gas-dark); font-weight: 700;">Ocurrió un error inesperado</h1>
            <p class="mb-3" style="color: var(--gas-muted);">Inténtalo de nuevo. Si el problema continúa, comparte este identificador con soporte.</p>
        }
        @if (Model.ShowRequestId)
        {
            <p><code>@Model.RequestId</code></p>
        }
        <a href="/" class="btn btn-gas">@Iconos.Svg("home") Volver al inicio</a>
    </div>
</div>
