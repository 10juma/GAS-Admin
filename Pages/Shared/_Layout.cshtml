<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f6f3" />
    <title>@ViewData["Title"] | GAS-Admin</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/gas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />
    @* Menú contraído: se aplica antes de pintar para que no "salte". *@
    <script>try { if (localStorage.getItem("gas.menu.mini") === "1") document.documentElement.classList.add("gas-mini"); } catch (e) { }</script>
</head>
<body class="gas-app">

    <partial name="_Sidebar" />
    <div class="gas-overlay" data-sidebar-close></div>

    <div class="gas-main">
        @* Solo en pantallas pequeñas: abre el menú lateral. *@
        <header class="gas-mobilebar">
            <button type="button" class="gas-icon-btn" data-sidebar-open aria-label="Abrir menú">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <a href="/" class="gas-mobilebar__brand">
                <img src="~/images/gas-logo.png" alt="" />
                <span>GAS-Admin</span>
            </a>
        </header>

        <main class="gas-content" role="main">
            @RenderBody()
        </main>

        <footer class="gas-footer">
            &copy; @DateTime.Now.Year Global App Suite · Software que resuelve problemas reales
        </footer>
    </div>

    @* Modal único para crear y editar. El contenido llega del servidor (data-modal-url)
       o de la sección "Modal" cuando hay que reabrirlo con errores o resultados. *@
    @{
        var abrirModalUrl = TempData["GAS.AbrirModal"] as string;
        var modalInicial = IsSectionDefined("Modal");
        var abrirModal = modalInicial && ViewData["AbrirModal"] is true;
    }
    <div class="modal fade gas-modal" id="gas-modal" tabindex="-1" aria-hidden="true"
         data-abrir="@(abrirModal ? "1" : null)" data-abrir-url="@abrirModalUrl">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content" id="gas-modal-content">
                @if (modalInicial)
                {
                    @await RenderSectionAsync("Modal")
                }
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <partial name="_Toasts" />
    <script src="~/js/toast.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
