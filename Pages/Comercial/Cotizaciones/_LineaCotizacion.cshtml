@model (GAS.Admin.Pages.Comercial.Cotizaciones.LineaInput Linea, bool Deshabilitado)
@using System.Globalization
@{
    var l = Model.Linea;
    var off = Model.Deshabilitado;
    string Num(decimal? d) => d?.ToString(CultureInfo.InvariantCulture) ?? "";
}
<tr data-linea>
    <td>
        <input type="hidden" data-campo="ServicioComercialId" value="@l.ServicioComercialId" />
        <input data-campo="Concepto" value="@l.Concepto" class="form-control form-control-sm mb-1" maxlength="200" placeholder="Concepto" aria-label="Concepto" disabled="@off" />
        <textarea data-campo="Descripcion" class="form-control form-control-sm" rows="1" maxlength="1000" placeholder="Descripción (opcional)" aria-label="Descripción" disabled="@off">@l.Descripcion</textarea>
    </td>
    <td><input data-campo="Cantidad" value="@Num(l.Cantidad)" type="number" min="0.01" step="0.01" class="form-control form-control-sm" aria-label="Cantidad" disabled="@off" /></td>
    <td><input data-campo="Unidad" value="@l.Unidad" class="form-control form-control-sm" maxlength="50" aria-label="Unidad" disabled="@off" /></td>
    <td><input data-campo="PrecioUnitario" value="@Num(l.PrecioUnitario)" type="number" min="0" step="0.01" class="form-control form-control-sm" aria-label="Precio unitario" disabled="@off" /></td>
    <td><input data-campo="DescuentoPorcentaje" value="@Num(l.DescuentoPorcentaje)" type="number" min="0" max="100" step="0.01" class="form-control form-control-sm" aria-label="Descuento %" disabled="@off" /></td>
    <td><input data-campo="CostoUnitario" value="@Num(l.CostoUnitario)" type="number" min="0" step="0.01" class="form-control form-control-sm" aria-label="Costo unitario" disabled="@off" /></td>
    <td class="text-end fw-semibold" data-importe>—</td>
    <td class="text-end">
        @if (!off)
        {
            <button type="button" class="gas-icon-btn" style="width: 30px; height: 30px;" data-quitar-linea aria-label="Quitar concepto">@Iconos.Svg("trash")</button>
        }
    </td>
</tr>
