@model GAS.Admin.Pages.Comercial.Catalogo.ServicioComercialModalVm
@using System.Globalization
@{
    var off = !Model.PuedeGestionar;
    var formId = Model.EsNuevo ? "form-catalogo-nuevo" : $"form-catalogo-{Model.Id}";
    var i = Model.Input;
    string Num(decimal? d) => d?.ToString(CultureInfo.InvariantCulture) ?? "";
}
<div data-size="xl" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon">@Iconos.Svg("layers")</span>
        <div class="min-w-0">
            <h2 class="modal-title">@(Model.EsNuevo ? "Nuevo servicio del catálogo" : i.Nombre)</h2>
            @if (Model.EsNuevo)
            {
                <div class="gas-modal__subtitle">Lo que vende GAS. El precio es de referencia; cada cotización guarda su propia copia.</div>
            }
            else
            {
                <div class="gas-badges mt-2">
                    <span class="gas-badge gas-badge--violet">@Etiquetas.Texto(i.Categoria)</span>
                    <span class="gas-badge @Etiquetas.Badge(i.Estado)">@Etiquetas.Texto(i.Estado)</span>
                    <span class="gas-chip gas-chip--info" style="pointer-events: none; padding-top: 2px; padding-bottom: 2px;">@Iconos.Svg("note") Cotizaciones <span class="gas-chip__count">@Model.Cotizaciones</span></span>
                    <partial name="_Trazabilidad" model="(Model.CreadoUtc, Model.CreadoPor, Model.ModificadoUtc, Model.ModificadoPor)" />
                </div>
            }
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>

    <div class="modal-body">
        <form id="@formId" method="post" novalidate asp-page="/Comercial/Catalogo/Index"
              asp-page-handler="@(Model.EsNuevo ? "Crear" : "Guardar")" asp-route-id="@Model.Id" data-margen>
            <input type="hidden" name="Estado" value="@Model.Filtro" />
            <input type="hidden" name="Q" value="@Model.Q" />
            <div class="row g-3">
                <div class="col-lg-7">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("pencil") Datos del servicio</h2></div>
                        <div class="gas-card__body">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label" for="@formId-nombre">Nombre</label>
                                    <input id="@formId-nombre" name="Input.Nombre" value="@i.Nombre" class="form-control" maxlength="150" disabled="@off"
                                           placeholder="Ej. Implementación de punto de venta" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="@formId-estado">Estado</label>
                                    <select id="@formId-estado" name="Input.Estado" class="form-select" disabled="@off">
                                        @foreach (var e in Etiquetas.Valores<EstadoCatalogo>())
                                        {
                                            <option value="@e" selected="@(e == i.Estado)">@Etiquetas.Texto(e)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="@formId-cat">Categoría</label>
                                    <select id="@formId-cat" name="Input.Categoria" class="form-select" disabled="@off">
                                        @foreach (var c in Etiquetas.Valores<CategoriaComercial>())
                                        {
                                            <option value="@c" selected="@(c == i.Categoria)">@Etiquetas.Texto(c)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="@formId-mod">Modalidad de cobro</label>
                                    <select id="@formId-mod" name="Input.Modalidad" class="form-select" disabled="@off">
                                        @foreach (var m in Etiquetas.Valores<ModalidadCobro>())
                                        {
                                            <option value="@m" selected="@(m == i.Modalidad)" data-unidad="@GAS.Admin.Pages.Comercial.Catalogo.ServicioComercialInput.UnidadSugerida(m)">@Etiquetas.Texto(m)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="@formId-prod">Producto relacionado</label>
                                    <select id="@formId-prod" name="Input.ProductoId" class="form-select" disabled="@off">
                                        <option value="">Ninguno</option>
                                        @foreach (var p in Model.Productos)
                                        {
                                            <option value="@p.Id" selected="@(p.Id == i.ProductoId)">@p.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@formId-desc">Descripción comercial</label>
                                    <textarea id="@formId-desc" name="Input.Descripcion" class="form-control" rows="3" maxlength="1000" disabled="@off"
                                              placeholder="Cómo se presenta al cliente en la cotización">@i.Descripcion</textarea>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="col-lg-5">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("dollar") Precio y costo</h2></div>
                        <div class="gas-card__body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-precio">Precio base</label>
                                    <input id="@formId-precio" name="Input.PrecioBase" value="@Num(i.PrecioBase)" type="number" min="0" step="0.01"
                                           class="form-control" disabled="@off" data-precio placeholder="A cotizar" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="@formId-moneda">Moneda</label>
                                    <select id="@formId-moneda" name="Input.Moneda" class="form-select" disabled="@off">
                                        @foreach (var m in GAS.Admin.Pages.Comercial.Catalogo.ServicioComercialInput.Monedas)
                                        {
                                            <option value="@m" selected="@(m == i.Moneda)">@m</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="@formId-unidad">Unidad</label>
                                    <input id="@formId-unidad" name="Input.Unidad" value="@i.Unidad" class="form-control" maxlength="50" disabled="@off" placeholder="hora, mes…" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-costo">Costo estimado</label>
                                    <input id="@formId-costo" name="Input.CostoEstimado" value="@Num(i.CostoEstimado)" type="number" min="0" step="0.01"
                                           class="form-control" disabled="@off" data-costo />
                                </div>
                                <div class="col-md-6">
                                    <span class="form-label d-block">Margen esperado</span>
                                    <div class="pt-2" data-margen-salida></div>
                                </div>
                            </div>
                            <div class="form-text mt-3">El costo incluye horas del equipo y gastos directos. El precio base es una referencia interna, no un precio público.</div>
                        </div>
                    </section>
                </div>

                <div class="col-lg-7">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("check") Alcance habitual</h2></div>
                        <div class="gas-card__body">
                            <label class="form-label" for="@formId-ent">Entregables</label>
                            <textarea id="@formId-ent" name="Input.Entregables" class="form-control" rows="3" maxlength="1000" disabled="@off"
                                      placeholder="Uno por línea">@i.Entregables</textarea>
                        </div>
                    </section>
                </div>
                <div class="col-lg-5">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("clock") Tiempo y notas</h2></div>
                        <div class="gas-card__body">
                            <label class="form-label" for="@formId-tiempo">Tiempo estimado</label>
                            <input id="@formId-tiempo" name="Input.TiempoEstimado" value="@i.TiempoEstimado" class="form-control mb-3" maxlength="100" disabled="@off" placeholder="Ej. 2 a 3 semanas" />
                            <label class="form-label" for="@formId-notas">Notas internas</label>
                            <textarea id="@formId-notas" name="Input.Notas" class="form-control" rows="2" maxlength="2000" disabled="@off">@i.Notas</textarea>
                        </div>
                    </section>
                </div>
            </div>
        </form>
    </div>

    <div class="modal-footer">
        @if (!Model.EsNuevo && Model.PuedeGestionar)
        {
            <form method="post" asp-page="/Comercial/Catalogo/Index" asp-page-handler="Eliminar" asp-route-id="@Model.Id"
                  data-confirm-title="¿Eliminar @i.Nombre del catálogo?"
                  data-confirm="Solo es posible si no se ha usado en cotizaciones. Para dejar de ofrecerlo, márcalo como Inactivo."
                  data-confirm-ok="Eliminar" data-confirm-tone="danger">
                <button type="submit" class="btn btn-gas-danger">@Iconos.Svg("trash") Eliminar</button>
            </form>
        }
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") @(Model.PuedeGestionar ? "Cancelar" : "Cerrar")</button>
            @if (Model.PuedeGestionar)
            {
                <button type="submit" form="@formId" class="btn btn-gas">
                    @if (Model.EsNuevo)
                    {
                        @Iconos.Svg("check") <span>Agregar al catálogo</span>
                    }
                    else
                    {
                        @Iconos.Svg("save") <span>Guardar cambios</span>
                    }
                </button>
            }
        </div>
    </div>
</div>
