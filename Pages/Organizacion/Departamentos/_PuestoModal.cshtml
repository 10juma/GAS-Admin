@model GAS.Admin.Pages.Organizacion.Departamentos.PuestoModalVm
@{
    var off = !Model.PuedeGestionar;
    var formId = Model.EsNuevo ? "form-puesto-nuevo" : $"form-puesto-{Model.Id}";
    var i = Model.Input;
}
<div data-size="md" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon gas-modal__icon--violet">@Iconos.Svg("layers")</span>
        <div class="min-w-0">
            <h2 class="modal-title">@(Model.EsNuevo ? "Nuevo puesto" : i.Nombre)</h2>
            @if (Model.Ocupantes.Count > 0)
            {
                <div class="gas-modal__subtitle">Ocupado por: @string.Join(", ", Model.Ocupantes)</div>
            }
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body">
        <form id="@formId" method="post" novalidate asp-page="/Organizacion/Departamentos/Index"
              asp-page-handler="@(Model.EsNuevo ? "CrearPuesto" : "GuardarPuesto")" asp-route-id="@Model.Id">
            <section class="gas-card">
                <div class="gas-card__header"><h2>@Iconos.Svg("pencil") Datos del puesto</h2></div>
                <div class="gas-card__body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="@formId-nombre">Nombre</label>
                            <input id="@formId-nombre" name="Puesto.Nombre" value="@i.Nombre" class="form-control" maxlength="100" disabled="@off" placeholder="Ej. Desarrollador full stack" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="@formId-depto">Departamento</label>
                            <select id="@formId-depto" name="Puesto.DepartamentoId" class="form-select" disabled="@off">
                                <option value="">Elegir…</option>
                                @foreach (var d in Model.Departamentos)
                                {
                                    <option value="@d.Id" selected="@(d.Id == i.DepartamentoId)">@d.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="@formId-desc">Responsabilidades</label>
                            <textarea id="@formId-desc" name="Puesto.Descripcion" class="form-control" rows="4" maxlength="1000" disabled="@off">@i.Descripcion</textarea>
                        </div>
                    </div>
                </div>
            </section>
        </form>
    </div>
    <div class="modal-footer">
        @if (!Model.EsNuevo && Model.PuedeGestionar)
        {
            <form method="post" asp-page="/Organizacion/Departamentos/Index" asp-page-handler="EliminarPuesto" asp-route-id="@Model.Id"
                  data-confirm-title="¿Eliminar el puesto @i.Nombre?" data-confirm="Solo es posible si nadie lo ocupa."
                  data-confirm-ok="Eliminar" data-confirm-tone="danger">
                <button type="submit" class="btn btn-gas-danger">@Iconos.Svg("trash") Eliminar</button>
            </form>
        }
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") @(Model.PuedeGestionar ? "Cancelar" : "Cerrar")</button>
            @if (Model.PuedeGestionar)
            {
                <button type="submit" form="@formId" class="btn btn-gas">@if (Model.EsNuevo) { @Iconos.Svg("check") <span>Crear puesto</span> } else { @Iconos.Svg("save") <span>Guardar</span> }</button>
            }
        </div>
    </div>
</div>
