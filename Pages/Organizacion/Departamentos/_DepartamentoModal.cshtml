@model GAS.Admin.Pages.Organizacion.Departamentos.DepartamentoModalVm
@{
    var off = !Model.PuedeGestionar;
    var formId = Model.EsNuevo ? "form-depto-nuevo" : $"form-depto-{Model.Id}";
    var i = Model.Input;
}
<div data-size="lg" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon">@Iconos.Svg("building")</span>
        <div class="min-w-0">
            <h2 class="modal-title">@(Model.EsNuevo ? "Nuevo departamento" : i.Nombre)</h2>
            @if (!Model.EsNuevo)
            {
                <div class="gas-badges mt-2">
                    <span class="gas-chip gas-chip--info" style="pointer-events: none; padding-top: 2px; padding-bottom: 2px;">@Iconos.Svg("users") Personas <span class="gas-chip__count">@Model.Integrantes</span></span>
                    <span class="gas-chip gas-chip--violet" style="pointer-events: none; padding-top: 2px; padding-bottom: 2px;">@Iconos.Svg("layers") Puestos <span class="gas-chip__count">@Model.Puestos</span></span>
                    <partial name="_Trazabilidad" model="(Model.CreadoUtc, Model.CreadoPor, Model.ModificadoUtc, Model.ModificadoPor)" />
                </div>
            }
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body">
        <form id="@formId" method="post" novalidate asp-page="/Organizacion/Departamentos/Index"
              asp-page-handler="@(Model.EsNuevo ? "Crear" : "Guardar")" asp-route-id="@Model.Id">
            <section class="gas-card">
                <div class="gas-card__header"><h2>@Iconos.Svg("pencil") Datos del departamento</h2></div>
                <div class="gas-card__body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label" for="@formId-nombre">Nombre</label>
                            <input id="@formId-nombre" name="Input.Nombre" value="@i.Nombre" class="form-control" maxlength="100" disabled="@off" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="@formId-orden">Orden</label>
                            <input id="@formId-orden" name="Input.Orden" value="@i.Orden" type="number" min="0" max="999" class="form-control" disabled="@off" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="@formId-desc">Descripción</label>
                            <textarea id="@formId-desc" name="Input.Descripcion" class="form-control" rows="2" maxlength="500" disabled="@off">@i.Descripcion</textarea>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label" for="@formId-resp">Responsable</label>
                            <select id="@formId-resp" name="Input.ResponsableId" class="form-select" disabled="@off">
                                <option value="">Sin responsable</option>
                                @foreach (var p in Model.Personas)
                                {
                                    <option value="@p.Id" selected="@(p.Id == i.ResponsableId)">@p.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <span class="form-label d-block">Color</span>
                            <div class="gas-colores">
                                @foreach (var c in GAS.Admin.Pages.Organizacion.Departamentos.DepartamentoInput.Colores)
                                {
                                    <label class="gas-color">
                                        <input type="radio" name="Input.Color" value="@c" checked="@(c == i.Color)" disabled="@off" />
                                        <span class="gas-avatar--@c" aria-label="Color @c"></span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </form>
    </div>
    <div class="modal-footer">
        @if (!Model.EsNuevo && Model.PuedeGestionar)
        {
            <form method="post" asp-page="/Organizacion/Departamentos/Index" asp-page-handler="Eliminar" asp-route-id="@Model.Id"
                  data-confirm-title="¿Eliminar @i.Nombre?"
                  data-confirm="Solo es posible si no tiene personas. Sus puestos también se eliminarán."
                  data-confirm-ok="Eliminar" data-confirm-tone="danger">
                <button type="submit" class="btn btn-gas-danger">@Iconos.Svg("trash") Eliminar</button>
            </form>
        }
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") @(Model.PuedeGestionar ? "Cancelar" : "Cerrar")</button>
            @if (Model.PuedeGestionar)
            {
                <button type="submit" form="@formId" class="btn btn-gas">@if (Model.EsNuevo) { @Iconos.Svg("check") <span>Crear departamento</span> } else { @Iconos.Svg("save") <span>Guardar cambios</span> }</button>
            }
        </div>
    </div>
</div>
