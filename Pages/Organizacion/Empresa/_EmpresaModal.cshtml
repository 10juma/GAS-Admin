@model GAS.Admin.Pages.Organizacion.Empresa.EmpresaInput
@{
    var formId = "form-empresa";
}
<div data-size="lg" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon">@Iconos.Svg("building")</span>
        <div>
            <h2 class="modal-title">Datos de la empresa</h2>
            <div class="gas-modal__subtitle">Aparecen en el encabezado y pie de los PDF de cotización.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body">
        <form id="@formId" method="post" novalidate asp-page="/Organizacion/Empresa/Index" asp-page-handler="Guardar">
            <section class="gas-card">
                <div class="gas-card__header"><h2>@Iconos.Svg("pencil") Identidad</h2></div>
                <div class="gas-card__body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="@formId-nc">Nombre comercial</label>
                            <input id="@formId-nc" name="Input.NombreComercial" value="@Model.NombreComercial" class="form-control" maxlength="200" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="@formId-lema">Lema</label>
                            <input id="@formId-lema" name="Input.Lema" value="@Model.Lema" class="form-control" maxlength="200" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label" for="@formId-rs">Razón social</label>
                            <input id="@formId-rs" name="Input.RazonSocial" value="@Model.RazonSocial" class="form-control" maxlength="200" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="@formId-rfc">RFC</label>
                            <input id="@formId-rfc" name="Input.Rfc" value="@Model.Rfc" class="form-control text-uppercase" maxlength="13" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="@formId-reg">Régimen fiscal</label>
                            <input id="@formId-reg" name="Input.RegimenFiscal" value="@Model.RegimenFiscal" class="form-control" maxlength="150" />
                        </div>
                    </div>
                </div>
            </section>
            <section class="gas-card">
                <div class="gas-card__header"><h2>@Iconos.Svg("mail") Domicilio y contacto</h2></div>
                <div class="gas-card__body">
                    <div class="row g-3">
                        <div class="col-md-9">
                            <label class="form-label" for="@formId-dom">Domicilio fiscal</label>
                            <input id="@formId-dom" name="Input.Domicilio" value="@Model.Domicilio" class="form-control" maxlength="500" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="@formId-cp">Código postal</label>
                            <input id="@formId-cp" name="Input.CodigoPostal" value="@Model.CodigoPostal" class="form-control" maxlength="5" inputmode="numeric" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="@formId-tel">Teléfono</label>
                            <input id="@formId-tel" name="Input.Telefono" value="@Model.Telefono" type="tel" class="form-control" maxlength="30" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="@formId-correo">Correo</label>
                            <input id="@formId-correo" name="Input.Correo" value="@Model.Correo" type="email" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="@formId-web">Sitio web</label>
                            <input id="@formId-web" name="Input.SitioWeb" value="@Model.SitioWeb" class="form-control" placeholder="https://" />
                        </div>
                    </div>
                </div>
            </section>
        </form>
    </div>
    <div class="modal-footer">
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") Cancelar</button>
            <button type="submit" form="@formId" class="btn btn-gas">@Iconos.Svg("save") Guardar</button>
        </div>
    </div>
</div>
