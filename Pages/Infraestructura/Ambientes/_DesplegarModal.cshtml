@model GAS.Admin.Pages.Infraestructura.Ambientes.DesplegarModalVm
@{
    var formId = $"form-desplegar-{Model.AmbienteId}";
}
<div data-size="lg" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon gas-modal__icon--violet">@Iconos.Svg("rocket")</span>
        <div class="min-w-0">
            <h2 class="modal-title">Desplegar @Model.Producto</h2>
            <div class="gas-modal__subtitle">En @Model.Servidor · @(Model.Repositorio ?? "")</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body">
        <form id="@formId" method="post" novalidate asp-page="/Infraestructura/Ambientes/Index" asp-page-handler="DesplegarAuto"
              data-confirm-title="¿Desplegar a producción?" data-confirm="Los contenedores se reemplazan uno por uno (unos segundos sin servicio cada uno). Si alguno no responde, todos regresan a su versión anterior."
              data-confirm-ok="Desplegar" data-confirm-tone="danger">
            <input type="hidden" name="volver" value="@Model.Volver" />
            <section class="gas-card mb-3">
                <div class="gas-card__body">
                    <label class="form-label" for="@formId-ref">Rama, etiqueta o commit</label>
                    <input id="@formId-ref" name="referencia" value="@Model.Referencia" class="form-control" maxlength="150" />
                    <div class="form-text">Se toma el último commit de esa rama en GitHub. Sube tus cambios antes de desplegar.</div>
                </div>
            </section>
            <section class="gas-card">
                <div class="gas-card__header"><div><h2>@Iconos.Svg("layers") Ambientes</h2><p>Se compilan todos primero; las migraciones van antes de reemplazar contenedores.</p></div></div>
                <div class="gas-card__body">
                    @foreach (var a in Model.Ambientes)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="@formId-a@(a.Id)" name="ambientes" value="@a.Id" checked />
                            <label class="form-check-label" for="@formId-a@(a.Id)">
                                <strong>@a.Nombre</strong> <span class="small text-muted">@a.Detalle</span>
                                @if (a.Migra) { <span class="gas-badge gas-badge--warning ms-1">respaldo + migraciones</span> }
                            </label>
                        </div>
                    }
                </div>
            </section>
            <p class="small text-muted mt-3 mb-0">¿Lo desplegaste a mano? <a href="#" data-modal-url="@Url.Page("/Infraestructura/Ambientes/Index", "Despliegue", new { ambienteId = Model.AmbienteId, volver = Model.Volver })">Solo registrarlo en la bitácora</a>.</p>
        </form>
    </div>
    <div class="modal-footer">
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") Cancelar</button>
            <button type="submit" form="@formId" class="btn btn-gas">@Iconos.Svg("rocket") Desplegar</button>
        </div>
    </div>
</div>
