@model GAS.Admin.Pages.Infraestructura.Dominios.DominioModalVm
@using System.Globalization
@{
    var off = !Model.PuedeGestionar;
    var formId = Model.EsNuevo ? "form-dom-nuevo" : $"form-dom-{Model.Id}";
    var i = Model.Input;
}
<div data-size="xl" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon">@Iconos.Svg("globe")</span>
        <div class="min-w-0">
            <h2 class="modal-title">@(Model.EsNuevo ? "Nuevo dominio" : i.Nombre)</h2>
            @if (!Model.EsNuevo)
            {
                <div class="gas-badges mt-2">
                    <span class="gas-badge @Etiquetas.Badge(i.Estado)">@Etiquetas.Texto(i.Estado)</span>
                    @if (Model.Cargos > 0) { <a asp-page="/Finanzas/Movimientos/Index" asp-route-vista="todos" asp-route-buscar="@i.Nombre" class="gas-badge gas-badge--violet gas-badge--btn text-decoration-none">@Iconos.Svg("dollar") @Model.Cargos cargo(s) en Finanzas</a> }
                    <partial name="_Trazabilidad" model="(Model.CreadoUtc, Model.CreadoPor, Model.ModificadoUtc, Model.ModificadoPor)" />
                </div>
            }
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body">
        <form id="@formId" method="post" novalidate asp-page="/Infraestructura/Dominios/Index" asp-page-handler="Guardar" asp-route-id="@Model.Id">
            <div class="row g-3">
                <div class="col-lg-7">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("pencil") Dominio</h2></div>
                        <div class="gas-card__body">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label class="form-label" for="@formId-nombre">Dominio</label>
                                    <input id="@formId-nombre" name="Input.Nombre" value="@i.Nombre" class="form-control" maxlength="253" disabled="@off" placeholder="ejemplo.mx" autocapitalize="off" spellcheck="false" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label" for="@formId-estado">Estado</label>
                                    <select id="@formId-estado" name="Input.Estado" class="form-select" disabled="@off">
                                        @foreach (var e in Etiquetas.Valores<EstadoDominio>()) { <option value="@e" selected="@(e == i.Estado)">@Etiquetas.Texto(e)</option> }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-prod">Producto</label>
                                    <select id="@formId-prod" name="Input.ProductoId" class="form-select" disabled="@off">
                                        <option value="">Ninguno (GAS)</option>
                                        @foreach (var p in Model.Productos) { <option value="@p.Id" selected="@(p.Id == i.ProductoId)">@p.Nombre</option> }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-reg">Registrador</label>
                                    <select id="@formId-reg" name="Input.RegistradorId" class="form-select" disabled="@off">
                                        <option value="">Ninguno</option>
                                        @foreach (var s in Model.Servicios) { <option value="@s.Id" selected="@(s.Id == i.RegistradorId)">@s.Nombre</option> }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@formId-dns">DNS administrado en</label>
                                    <input id="@formId-dns" name="Input.Dns" value="@i.Dns" class="form-control" maxlength="150" disabled="@off" placeholder="Ej. GoDaddy, Cloudflare, Vercel" />
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="col-lg-5">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><div><h2>@Iconos.Svg("refresh") Renovación</h2><p>Con costo y fecha se genera el cargo en Finanzas.</p></div></div>
                        <div class="gas-card__body">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label class="form-label" for="@formId-vence">Vence</label>
                                    <input id="@formId-vence" name="Input.FechaVencimiento" value="@i.FechaVencimiento?.ToString("yyyy-MM-dd")" type="date" class="form-control" disabled="@off" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label" for="@formId-anios">Años</label>
                                    <input id="@formId-anios" name="Input.AniosRenovacion" value="@i.AniosRenovacion" type="number" min="1" max="10" class="form-control" disabled="@off" />
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label" for="@formId-costo">Costo por renovación</label>
                                    <input id="@formId-costo" name="Input.Costo" value="@i.Costo?.ToString(CultureInfo.InvariantCulture)" type="number" min="0" step="0.01" class="form-control" disabled="@off" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label" for="@formId-mon">Moneda</label>
                                    <select id="@formId-mon" name="Input.Moneda" class="form-select" disabled="@off">
                                        @foreach (var m in GAS.Admin.Services.Finanzas.ServicioFinanzas.Monedas) { <option value="@m" selected="@(m == i.Moneda)">@m</option> }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@formId-auto">Renovación automática</label>
                                    <select id="@formId-auto" name="Input.RenovacionAutomatica" class="form-select" disabled="@off">
                                        <option value="false" selected="@(!i.RenovacionAutomatica)">No, se renueva a mano</option>
                                        <option value="true" selected="@i.RenovacionAutomatica">Sí, se cobra automáticamente</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="col-lg-7">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("note") Notas</h2></div>
                        <div class="gas-card__body">
                            <textarea name="Input.Notas" class="form-control" rows="3" maxlength="2000" disabled="@off" placeholder="Subdominios, redirecciones, correo asociado…">@i.Notas</textarea>
                        </div>
                    </section>
                </div>
                <div class="col-lg-5">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("lock") Certificado SSL</h2></div>
                        <div class="gas-card__body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-ssl">Vence</label>
                                    <input id="@formId-ssl" name="Input.SslVence" value="@i.SslVence?.ToString("yyyy-MM-dd")" type="date" class="form-control" disabled="@off" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-emisor">Emisor</label>
                                    <input id="@formId-emisor" name="Input.SslEmisor" value="@i.SslEmisor" class="form-control" maxlength="100" disabled="@off" placeholder="Let's Encrypt" />
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </form>
    </div>
    <div class="modal-footer">
        @if (!Model.EsNuevo && Model.PuedeGestionar)
        {
            <form method="post" asp-page="/Infraestructura/Dominios/Index" asp-page-handler="Eliminar" asp-route-id="@Model.Id"
                  data-confirm-title="¿Eliminar @i.Nombre?" data-confirm="Si ya tiene cargos en Finanzas no se podrá; márcalo como Cancelado."
                  data-confirm-ok="Eliminar" data-confirm-tone="danger">
                <button type="submit" class="btn btn-gas-danger">@Iconos.Svg("trash") Eliminar</button>
            </form>
        }
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") @(Model.PuedeGestionar ? "Cancelar" : "Cerrar")</button>
            @if (Model.PuedeGestionar)
            {
                <button type="submit" form="@formId" class="btn btn-gas">@Iconos.Svg(Model.EsNuevo ? "check" : "save") @(Model.EsNuevo ? "Registrar" : "Guardar cambios")</button>
            }
        </div>
    </div>
</div>
