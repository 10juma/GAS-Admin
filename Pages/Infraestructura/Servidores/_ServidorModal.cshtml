@model GAS.Admin.Pages.Infraestructura.Servidores.ServidorModalVm
@{
    var formId = Model.EsNuevo ? "form-srv-nuevo" : $"form-srv-{Model.Id}";
    var i = Model.Input;
}
<div data-size="lg" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon">@Iconos.Svg("server")</span>
        <div class="min-w-0">
            <h2 class="modal-title">@(Model.EsNuevo ? "Nuevo servidor" : i.Nombre)</h2>
            @if (Model.Servidor is { } s)
            {
                <div class="gas-badges mt-2">
                    <span class="gas-badge @Etiquetas.Badge(s.Estado)">@Etiquetas.Texto(s.Estado)</span>
                    @foreach (var a in Model.Ambientes) { <span class="gas-badge gas-badge--info">@Iconos.Svg("layers") @a</span> }
                    <partial name="_Trazabilidad" model="(s.CreadoUtc, s.CreadoPor, s.ModificadoUtc, s.ModificadoPor)" />
                </div>
            }
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body">
        <form id="@formId" method="post" novalidate asp-page="/Infraestructura/Servidores/Index" asp-page-handler="@(Model.EsNuevo ? "Crear" : "Guardar")" asp-route-id="@Model.Id">
            <section class="gas-card">
                <div class="gas-card__body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="@formId-nombre">Nombre</label>
                            <input id="@formId-nombre" name="Input.Nombre" value="@i.Nombre" class="form-control" maxlength="100" placeholder="Ej. VPS producción" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="@formId-host">IP o dominio</label>
                            <input id="@formId-host" name="Input.Host" value="@i.Host" class="form-control" maxlength="253" placeholder="Ej. 203.0.113.10" autocomplete="off" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="@formId-puerto">Puerto SSH</label>
                            <input id="@formId-puerto" name="Input.Puerto" value="@i.Puerto" type="number" min="1" max="65535" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="@formId-notas">Notas</label>
                            <textarea id="@formId-notas" name="Input.Notas" class="form-control" rows="2" maxlength="2000" placeholder="Proveedor, plan, qué corre aquí…">@i.Notas</textarea>
                        </div>
                    </div>
                </div>
            </section>
            <p class="small text-muted mt-3 mb-0">@Iconos.Svg("lock") La dirección se guarda cifrada (AES-256-GCM con la llave maestra de GAS-Admin). Si la cambias, hay que volver a preparar el servidor.</p>
        </form>
    </div>
    <div class="modal-footer">
        @if (!Model.EsNuevo)
        {
            <form method="post" asp-page="/Infraestructura/Servidores/Index" asp-page-handler="Eliminar" asp-route-id="@Model.Id"
                  data-confirm-title="¿Eliminar @i.Nombre?" data-confirm="Se borran el registro y la llave de GAS-Admin. El usuario gasdeploy sigue existiendo en el servidor (puedes borrarlo a mano)."
                  data-confirm-ok="Eliminar" data-confirm-tone="danger">
                <button type="submit" class="btn btn-gas-danger">@Iconos.Svg("trash") Eliminar</button>
            </form>
        }
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") Cancelar</button>
            <button type="submit" form="@formId" class="btn btn-gas">@Iconos.Svg(Model.EsNuevo ? "check" : "save") @(Model.EsNuevo ? "Registrar" : "Guardar cambios")</button>
        </div>
    </div>
</div>
