@model GAS.Admin.Pages.Proyectos.TrabajoModalVm
@using System.Globalization
@{
    var off = !Model.PuedeGestionar;
    var formId = Model.EsNuevo ? "form-trabajo-nuevo" : $"form-trabajo-{Model.Id}";
    var i = Model.Input;
    var interno = i.Tipo == TipoTrabajoOperativo.ProyectoInterno;
}
<div data-size="xl" style="display: contents;">
    <div class="modal-header">
        <span class="gas-modal__icon">@Iconos.Svg("layers")</span>
        <div class="min-w-0">
            <h2 class="modal-title">@(Model.EsNuevo ? "Nuevo trabajo" : $"{Model.Folio} · {i.Nombre}")</h2>
            @if (Model.EsNuevo)
            {
                <div class="gas-modal__subtitle">Para trabajos que vienen de una cotización, apruébala en Comercial y se crea solo.</div>
            }
            else
            {
                <div class="gas-badges mt-2">
                    <span class="gas-badge @Etiquetas.Badge(i.Tipo)">@Etiquetas.Texto(i.Tipo)</span>
                    <span class="gas-badge @Etiquetas.Badge(i.Estado)">@Etiquetas.Texto(i.Estado)</span>
                    @if (Model.Cotizacion is not null)
                    {
                        <a class="gas-badge gas-badge--info gas-badge--btn text-decoration-none" href="@Url.Page("/Comercial/Cotizaciones/Index", new { abrir = Model.CotizacionId })">@Iconos.Svg("note") @Model.Cotizacion</a>
                    }
                    <partial name="_Trazabilidad" model="(Model.CreadoUtc, Model.CreadoPor, Model.ModificadoUtc, Model.ModificadoPor)" />
                </div>
            }
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>

    <div class="modal-body">
        <form id="@formId" method="post" novalidate asp-page="/Proyectos/Index"
              asp-page-handler="@(Model.EsNuevo ? "Crear" : "Guardar")" asp-route-id="@Model.Id">
            <input type="hidden" name="volver" value="@Model.Volver" />
            <div class="row g-3">
                <div class="col-lg-7">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("pencil") Datos del trabajo</h2></div>
                        <div class="gas-card__body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="@formId-nombre">Nombre</label>
                                    <input id="@formId-nombre" name="Input.Nombre" value="@i.Nombre" class="form-control" maxlength="200" disabled="@off" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="@formId-tipo">Tipo</label>
                                    <select id="@formId-tipo" name="Input.Tipo" class="form-select" disabled="@off" data-tipo-trabajo>
                                        @foreach (var t in Etiquetas.Valores<TipoTrabajoOperativo>())
                                        {
                                            <option value="@t" selected="@(t == i.Tipo)">@Etiquetas.Texto(t)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4 @(interno ? "d-none" : "")" data-solo-externo>
                                    <label class="form-label" for="@formId-cliente">Cliente</label>
                                    <select id="@formId-cliente" name="Input.ClienteId" class="form-select" disabled="@off">
                                        <option value="">Elegir…</option>
                                        @foreach (var c in Model.Clientes) { <option value="@c.Id" selected="@(c.Id == i.ClienteId)">@c.Nombre</option> }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="@formId-prod">Producto <span class="text-muted fw-normal" data-solo-externo>(opcional)</span></label>
                                    <select id="@formId-prod" name="Input.ProductoId" class="form-select" disabled="@off">
                                        <option value="">Ninguno</option>
                                        @foreach (var p in Model.Productos) { <option value="@p.Id" selected="@(p.Id == i.ProductoId)">@p.Nombre</option> }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@formId-desc">Descripción y alcance</label>
                                    <textarea id="@formId-desc" name="Input.Descripcion" class="form-control" rows="3" maxlength="2000" disabled="@off">@i.Descripcion</textarea>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="col-lg-5">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("calendar") Seguimiento</h2></div>
                        <div class="gas-card__body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-estado">Estado</label>
                                    <select id="@formId-estado" name="Input.Estado" class="form-select" disabled="@off">
                                        @foreach (var e in Etiquetas.Valores<EstadoTrabajo>()) { <option value="@e" selected="@(e == i.Estado)">@Etiquetas.Texto(e)</option> }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-prio">Prioridad</label>
                                    <select id="@formId-prio" name="Input.Prioridad" class="form-select" disabled="@off">
                                        @foreach (var p in Etiquetas.Valores<Prioridad>()) { <option value="@p" selected="@(p == i.Prioridad)">@Etiquetas.Texto(p)</option> }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-depto">Departamento</label>
                                    <select id="@formId-depto" name="Input.DepartamentoId" class="form-select" disabled="@off">
                                        <option value="">Ninguno</option>
                                        @foreach (var d in Model.Departamentos) { <option value="@d.Id" selected="@(d.Id == i.DepartamentoId)">@d.Nombre</option> }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-resp">Responsable</label>
                                    <select id="@formId-resp" name="Input.ResponsableId" class="form-select" disabled="@off">
                                        <option value="">Sin asignar</option>
                                        @foreach (var p in Model.Personas) { <option value="@p.Id" selected="@(p.Id == i.ResponsableId)">@p.Nombre</option> }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-ini">Inicio</label>
                                    <input id="@formId-ini" name="Input.FechaInicio" value="@i.FechaInicio?.ToString("yyyy-MM-dd")" type="date" class="form-control" disabled="@off" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-fin">Entrega comprometida</label>
                                    <input id="@formId-fin" name="Input.FechaEntrega" value="@i.FechaEntrega?.ToString("yyyy-MM-dd")" type="date" class="form-control" disabled="@off" />
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="col-lg-7">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("note") Notas</h2></div>
                        <div class="gas-card__body">
                            <textarea name="Input.Notas" class="form-control" rows="3" maxlength="2000" disabled="@off">@i.Notas</textarea>
                        </div>
                    </section>
                </div>

                <div class="col-lg-5">
                    <section class="gas-card h-100">
                        <div class="gas-card__header">
                            <div><h2>@Iconos.Svg("dollar") Presupuesto</h2><p>Ingreso esperado sin IVA y gastos directos.</p></div>
                        </div>
                        <div class="gas-card__body">
                            @if (Model.VerFinanzas)
                            {
                                var offF = !Model.EditarFinanzas;
                                <div class="row g-3">
                                    <div class="col-7">
                                        <label class="form-label" for="@formId-pres">@(i.Tipo == TipoTrabajoOperativo.ServicioRecurrente ? "Monto mensual" : "Presupuesto")</label>
                                        <input id="@formId-pres" name="Input.Presupuesto" value="@i.Presupuesto?.ToString(CultureInfo.InvariantCulture)" type="number" min="0" step="0.01" class="form-control" disabled="@offF" />
                                    </div>
                                    <div class="col-5">
                                        <label class="form-label" for="@formId-mon">Moneda</label>
                                        <select id="@formId-mon" name="Input.Moneda" class="form-select" disabled="@offF">
                                            @foreach (var m in GAS.Admin.Pages.Proyectos.TrabajoInput.Monedas) { <option value="@m" selected="@(m == i.Moneda)">@m</option> }
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="@formId-gastos">Gastos directos</label>
                                        <input id="@formId-gastos" name="Input.GastosDirectos" value="@i.GastosDirectos.ToString(CultureInfo.InvariantCulture)" type="number" min="0" step="0.01" class="form-control" disabled="@offF" />
                                        <div class="form-text">Licencias, subcontratos u otros costos del trabajo (no incluye horas).</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2 text-muted small">@Iconos.Svg("lock") Solo visible con permiso de Finanzas.</div>
                            }
                        </div>
                    </section>
                </div>
            </div>
        </form>
    </div>

    <div class="modal-footer">
        @if (!Model.EsNuevo && Model.PuedeGestionar)
        {
            <form method="post" asp-page="/Proyectos/Index" asp-page-handler="Eliminar" asp-route-id="@Model.Id"
                  data-confirm-title="¿Eliminar @Model.Folio?"
                  data-confirm="Se eliminarán también sus entregables y tareas. Si ya tiene horas o archivos no se podrá; en ese caso cámbialo a Cancelado."
                  data-confirm-ok="Eliminar" data-confirm-tone="danger">
                <button type="submit" class="btn btn-gas-danger">@Iconos.Svg("trash") Eliminar</button>
            </form>
        }
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") @(Model.PuedeGestionar ? "Cancelar" : "Cerrar")</button>
            @if (Model.PuedeGestionar)
            {
                <button type="submit" form="@formId" class="btn btn-gas">@if (Model.EsNuevo) { @Iconos.Svg("check") <span>Crear trabajo</span> } else { @Iconos.Svg("save") <span>Guardar cambios</span> }</button>
            }
        </div>
    </div>
</div>
