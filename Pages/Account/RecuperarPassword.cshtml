@page
@model GAS.Admin.Pages.Account.RecuperarPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutAcceso";
    var errorGeneral = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<div class="welcome-heading">
    <div class="welcome-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6M15.5 7.5l3 3L22 7l-3-3"/>
        </svg>
    </div>
    <div class="welcome-text">
        <h1>Recuperar contraseña</h1>
        <p>Te enviamos un enlace para definir una nueva.</p>
    </div>
</div>

@if (!Model.Disponible)
{
    <div class="login-alert login-alert--info" role="status">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <span>La recuperación por correo todavía no está disponible. Pide a un administrador que restablezca tu contraseña desde <strong>Administración → Usuarios</strong>.</span>
    </div>
}
else if (Model.Enviado)
{
    <div class="login-alert" role="status">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        <span>Si <strong>@Model.Email</strong> pertenece a una cuenta activa, te llegará un correo con el enlace en unos minutos.
            El enlace vence en @GAS.Admin.Services.Seguridad.RecuperacionPassword.Vigencia.TotalMinutes.ToString("0") minutos. Revisa también la carpeta de spam.</span>
    </div>
}
else
{
    <p class="login-description">Escribe el correo con el que entras a GAS-Admin.</p>

    <form class="login-form" method="post" novalidate>
        @if (errorGeneral is not null)
        {
            <div class="login-alert login-alert--error" role="alert">@errorGeneral</div>
        }
        <div class="form-group">
            <label asp-for="Email"></label>
            <div class="input-wrapper">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
                </svg>
                <input asp-for="Email" type="email" placeholder="tu@globalappsuite.com.mx" autocomplete="username" required autofocus />
            </div>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="login-button">
            Enviar enlace
            <span aria-hidden="true">→</span>
        </button>
    </form>
}

<a asp-page="/Account/Login" class="back-link">← Volver a iniciar sesión</a>
