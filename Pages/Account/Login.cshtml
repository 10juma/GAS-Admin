@page "/Account/Login"
@model GAS.Admin.Pages.Account.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f6f3" />
    <title>GAS-Admin | Global App Suite</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />

    <partial name="_Favicon" />

</head>
<body>

    <main class="login-page">
        <section class="login-card">

            <div class="card-brand">
                <img src="~/images/gas-logo.png"
                     alt="Global App Suite"
                     class="brand-logo" />
                <div class="brand-info">
                    <span class="brand-name">GLOBAL APP SUITE</span>
                    <span class="brand-subtitle">ADMINISTRATION</span>
                </div>
            </div>
            <div class="brand-divider"></div>

            <div class="welcome-heading">
                <div class="welcome-icon">
                    <svg viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M8 11V7a2 2 0 0 1 4 0v3"/>
                        <path d="M12 10V5a2 2 0 0 1 4 0v6"/>
                        <path d="M16 10V7a2 2 0 0 1 4 0v7"/>
                        <path d="M8 10V9a2 2 0 0 0-4 0v6c0 4 3 7 7 7h2c4 0 7-3 7-7"/>
                        <path d="m4 3 1.5 1.5M20 3l-1.5 1.5"/>
                    </svg>
                </div>

                <div class="welcome-text">
                    <h1>¡Bienvenido!</h1>
                    <p>Nos alegra tenerte de vuelta.</p>
                </div>
            </div>

            <p class="login-description">
                Ingresa tus credenciales para continuar.
            </p>

            <form class="login-form" method="post" novalidate>

                <input type="hidden" asp-for="ReturnUrl" />

                <div class="form-group">
                    <label asp-for="Input.Email"></label>

                    <div class="input-wrapper">
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2"/>
                            <path d="m3 7 9 6 9-6"/>
                        </svg>

                        <input asp-for="Input.Email"
                               type="email"
                               placeholder="tu@globalappsuite.com.mx"
                               autocomplete="username"
                               required />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password"></label>

                    <div class="input-wrapper">
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true">
                            <rect x="4" y="10" width="16" height="11" rx="2"/>
                            <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
                            <path d="M12 14v3"/>
                        </svg>

                        <input asp-for="Input.Password"
                               type="password"
                               placeholder="Ingresa tu contraseña"
                               autocomplete="current-password"
                               required />

                        <button class="toggle-password"
                                type="button"
                                id="togglePassword"
                                aria-label="Mostrar contraseña">
                            <svg id="eyeIcon" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="1.7"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="form-options">
                    <label class="remember-option">
                        <input asp-for="Input.RememberMe" type="checkbox" />
                        <span>Recordarme</span>
                    </label>

                    <a asp-page="/Account/RecuperarPassword" class="forgot-link">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

                <button type="submit" class="login-button">
                    Iniciar sesión
                    <span aria-hidden="true">→</span>
                </button>

            </form>

            <div class="security-note">
                <svg viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"/>
                    <path d="m9 12 2 2 4-4"/>
                </svg>
                Acceso seguro para colaboradores
            </div>

        </section>

        <footer class="login-footer">
            <span>GLOBAL APP SUITE</span>
            <span>SOFTWARE QUE RESUELVE PROBLEMAS REALES</span>
        </footer>

    </main>

    <partial name="_Toasts" />
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        const passwordInput = document.getElementById("Input_Password");
        const togglePassword = document.getElementById("togglePassword");
        const eyeIcon = document.getElementById("eyeIcon");

        togglePassword.addEventListener("click", () => {
            const showing = passwordInput.type === "text";

            passwordInput.type = showing ? "password" : "text";

            togglePassword.setAttribute(
                "aria-label",
                showing ? "Mostrar contraseña" : "Ocultar contraseña"
            );

            eyeIcon.innerHTML = showing
                ? '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>'
                : '<path d="m3 3 18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A11 11 0 0 1 12 5c6.4 0 10 7 10 7a15 15 0 0 1-3.1 3.9"/><path d="M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10 10 0 0 0 3-.5"/>';
        });
    </script>

</body>
</html>
