@page
@model GAS.Admin.Pages.Account.NuevaPasswordModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = "_LayoutAcceso";
    var errores = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? [];
}

<div class="welcome-heading">
    <div class="welcome-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/>
        </svg>
    </div>
    <div class="welcome-text">
        <h1>Nueva contraseña</h1>
        <p>@(Model.Email ?? "Restablece tu acceso a GAS-Admin.")</p>
    </div>
</div>

@if (Model.EnlaceInvalido)
{
    <div class="login-alert login-alert--error" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4M12 17h.01"/></svg>
        <span>El enlace no es válido, ya se usó o venció. Solicita uno nuevo.</span>
    </div>
    <a asp-page="/Account/RecuperarPassword" class="login-button" style="text-decoration: none;">Solicitar otro enlace <span aria-hidden="true">→</span></a>
}
else
{
    <form class="login-form" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Codigo" />
        @if (errores.Count > 0)
        {
            <div class="login-alert login-alert--error" role="alert"><span>@string.Join(" ", errores)</span></div>
        }

        <div class="form-group">
            <label asp-for="Password"></label>
            <div class="input-wrapper">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/>
                </svg>
                <input asp-for="Password" type="password" autocomplete="new-password" placeholder="Mínimo 10 caracteres" required autofocus />
            </div>
            <span class="form-hint">Con mayúscula, minúscula y número.</span>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Confirmacion"></label>
            <div class="input-wrapper">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5"/>
                </svg>
                <input asp-for="Confirmacion" type="password" autocomplete="new-password" placeholder="Escríbela otra vez" required />
            </div>
            <span asp-validation-for="Confirmacion" class="field-error"></span>
        </div>

        <button type="submit" class="login-button">
            Guardar contraseña
            <span aria-hidden="true">→</span>
        </button>
    </form>
}

<a asp-page="/Account/Login" class="back-link">← Volver a iniciar sesión</a>
