@page
@model GAS.Admin.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    ViewData["Seccion"] = "Mi cuenta";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        @if (Model.Obligatorio)
        {
            <div class="gas-callout" role="status">
                <div class="gas-callout__text">
                    <strong>Define tu contraseña</strong>
                    Estás usando una contraseña temporal. Cámbiala para poder usar GAS-Admin.
                </div>
            </div>
        }

        <section class="gas-card">
            <div class="gas-card__header">
                <div>
                    <h2>@Iconos.Svg("key") Cambiar contraseña</h2>
                    <p>Mínimo 10 caracteres, con mayúscula, minúscula y número.</p>
                </div>
            </div>
            <div class="gas-card__body">
                <form method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="Input.CurrentPassword" class="form-label"></label>
                        <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label"></label>
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        @if (!Model.Obligatorio)
                        {
                            <a href="/" class="btn btn-gas-outline">@Iconos.Svg("x") Cancelar</a>
                        }
                        <button type="submit" class="btn btn-gas">@Iconos.Svg("save") Guardar contraseña</button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>
