@page
@model GAS.Admin.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="gas-card" style="max-width: 560px; margin: 40px auto;">
    <div class="gas-card__body text-center" style="padding: 40px 28px;">
        <div class="gas-avatar gas-avatar--lg mx-auto mb-3" style="background: var(--gas-warning-bg); color: var(--gas-warning);">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        </div>
        <h1 class="h5 mb-2" style="color: var(--gas-dark); font-weight: 700;">No tienes acceso a esta sección</h1>
        <p class="mb-4" style="color: var(--gas-muted);">Tu rol no incluye el permiso necesario. Si lo necesitas, pide a un administrador que lo agregue a tu rol.</p>
        <a href="/" class="btn btn-gas">@Iconos.Svg("home") Volver al dashboard</a>
    </div>
</div>
