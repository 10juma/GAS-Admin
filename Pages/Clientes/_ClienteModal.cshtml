@model GAS.Admin.Pages.Clientes.ClienteModalVm
@{
    var off = !Model.PuedeGestionar;
    var formId = Model.EsNuevo ? "form-cliente-nuevo" : $"form-cliente-{Model.Id}";
    var i = Model.Input;
    var nombre = string.IsNullOrWhiteSpace(i.NombreComercial) ? i.Nombre : i.NombreComercial;
    var responsable = (Nombre: "Input.ResponsableId", Id: formId + "-resp", Seleccionado: i.ResponsableId, Opciones: Model.Responsables, Deshabilitado: off);
}
<div data-size="xl" style="display: contents;">
    <div class="modal-header">
        @if (Model.EsNuevo)
        {
            <span class="gas-modal__icon">@Iconos.Svg("building")</span>
            <div>
                <h2 class="modal-title">Nuevo cliente</h2>
                <div class="gas-modal__subtitle">Una organización se registra una sola vez y se relaciona con los productos que usa.</div>
            </div>
        }
        else
        {
            <span class="gas-avatar gas-avatar--lg @Avatar.Clase(nombre)" style="border-radius: 12px;">@Avatar.Iniciales(nombre)</span>
            <div class="min-w-0">
                <h2 class="modal-title">@nombre</h2>
                @if (!string.IsNullOrWhiteSpace(i.NombreComercial))
                {
                    <div class="gas-modal__subtitle">@i.Nombre@(string.IsNullOrEmpty(i.Rfc) ? "" : " · " + i.Rfc)</div>
                }
                <div class="gas-badges mt-2">
                    <span class="gas-badge @Etiquetas.Badge(i.Estado)">@Etiquetas.Texto(i.Estado)</span>
                    <partial name="_Trazabilidad" model="(Model.CreadoUtc, Model.CreadoPor, Model.ModificadoUtc, Model.ModificadoPor)" />
                </div>
            </div>
        }
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>

    <div class="modal-body">
        <form id="@formId" method="post" novalidate asp-page="/Clientes/Index"
              asp-page-handler="@(Model.EsNuevo ? "Crear" : "Guardar")" asp-route-id="@Model.Id">
            <input type="hidden" name="Estado" value="@Model.Filtro" />
            <input type="hidden" name="Producto" value="@Model.FiltroProducto" />
            <input type="hidden" name="Q" value="@Model.Q" />
            <div class="row g-3">
                <div class="col-lg-7">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("building") Datos generales</h2></div>
                        <div class="gas-card__body">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label class="form-label" for="@formId-nombre">Nombre o razón social</label>
                                    <input id="@formId-nombre" name="Input.Nombre" value="@i.Nombre" class="form-control" maxlength="200" disabled="@off" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label" for="@formId-nc">Nombre comercial</label>
                                    <input id="@formId-nc" name="Input.NombreComercial" value="@i.NombreComercial" class="form-control" maxlength="200" disabled="@off" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="@formId-rfc">RFC</label>
                                    <input id="@formId-rfc" name="Input.Rfc" value="@i.Rfc" class="form-control text-uppercase" maxlength="13" disabled="@off" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="@formId-estado">Estado</label>
                                    <select id="@formId-estado" name="Input.Estado" class="form-select" disabled="@off">
                                        @foreach (var e in Etiquetas.Valores<EstadoCliente>())
                                        {
                                            <option value="@e" selected="@(e == i.Estado)">@Etiquetas.Texto(e)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="@formId-ciudad">Ciudad</label>
                                    <input id="@formId-ciudad" name="Input.Ciudad" value="@i.Ciudad" class="form-control" maxlength="100" disabled="@off" />
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label" for="@formId-web">Sitio web</label>
                                    <input id="@formId-web" name="Input.SitioWeb" value="@i.SitioWeb" class="form-control" placeholder="https://" disabled="@off" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label" for="@formId-resp">Responsable en GAS</label>
                                    <partial name="_SelectResponsable" model="responsable" />
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="col-lg-5">
                    <section class="gas-card h-100">
                        <div class="gas-card__header"><h2>@Iconos.Svg("users") Contacto principal</h2></div>
                        <div class="gas-card__body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="@formId-cn">Nombre</label>
                                    <input id="@formId-cn" name="Input.ContactoNombre" value="@i.ContactoNombre" class="form-control" maxlength="150" disabled="@off" />
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label" for="@formId-ce">Correo</label>
                                    <input id="@formId-ce" name="Input.ContactoEmail" value="@i.ContactoEmail" type="email" class="form-control" disabled="@off" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label" for="@formId-ct">Teléfono</label>
                                    <input id="@formId-ct" name="Input.ContactoTelefono" value="@i.ContactoTelefono" type="tel" class="form-control" maxlength="30" disabled="@off" />
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="col-12">
                    <section class="gas-card">
                        <div class="gas-card__header">
                            <div>
                                <h2>@Iconos.Svg("box") Productos que usa</h2>
                                <p>Elige el estado en cada producto; "No lo usa" quita la relación.</p>
                            </div>
                        </div>
                        <div class="gas-card__body">
                            <div class="gas-options" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));">
                                @for (var n = 0; n < i.Productos.Count; n++)
                                {
                                    var rel = i.Productos[n];
                                    var prod = Model.ProductosDisponibles.FirstOrDefault(p => p.Id == rel.ProductoId);
                                    if (prod is null) continue;
                                    <div class="gas-option gas-option--static @(rel.Estado is null ? "" : "is-on")">
                                        <span class="gas-avatar gas-avatar--sm @Avatar.Clase(prod.Nombre)" style="border-radius: 8px;">@Avatar.Iniciales(prod.Nombre)</span>
                                        <div class="flex-grow-1 min-w-0">
                                            <strong>@prod.Nombre</strong>
                                            <input type="hidden" name="Input.Productos[@n].ProductoId" value="@rel.ProductoId" />
                                            <div class="d-flex gap-2 mt-2">
                                                <select name="Input.Productos[@n].Estado" class="form-select form-select-sm" aria-label="Estado en @prod.Nombre" disabled="@off" data-toggle-on>
                                                    <option value="" selected="@(rel.Estado is null)">No lo usa</option>
                                                    @foreach (var e in Etiquetas.Valores<EstadoClienteProducto>())
                                                    {
                                                        <option value="@e" selected="@(rel.Estado == e)">@Etiquetas.Texto(e)</option>
                                                    }
                                                </select>
                                                <input type="date" name="Input.Productos[@n].Desde" value="@rel.Desde?.ToString("yyyy-MM-dd")"
                                                       class="form-control form-control-sm" style="max-width: 150px;" aria-label="Desde" title="Desde" disabled="@off" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                </div>

                <div class="col-12">
                    <section class="gas-card">
                        <div class="gas-card__header"><h2>@Iconos.Svg("note") Notas</h2></div>
                        <div class="gas-card__body">
                            <textarea name="Input.Notas" class="form-control" rows="2" maxlength="2000" disabled="@off">@i.Notas</textarea>
                        </div>
                    </section>
                </div>
            </div>
        </form>
    </div>

    <div class="modal-footer">
        @if (!Model.EsNuevo && Model.PuedeGestionar)
        {
            <div class="dropup">
                <button type="button" class="btn btn-gas-outline" data-bs-toggle="dropdown" aria-expanded="false">@Iconos.Svg("lock") Acciones</button>
                <div class="dropdown-menu">
                    @if (!string.IsNullOrEmpty(i.ContactoEmail))
                    {
                        <a class="dropdown-item" href="mailto:@i.ContactoEmail">@Iconos.Svg("mail") Escribir al contacto</a>
                    }
                    @if (!string.IsNullOrEmpty(i.SitioWeb))
                    {
                        <a class="dropdown-item" href="@i.SitioWeb" target="_blank" rel="noopener">@Iconos.Svg("external") Abrir sitio web</a>
                    }
                    @if (!string.IsNullOrEmpty(i.ContactoEmail) || !string.IsNullOrEmpty(i.SitioWeb))
                    {
                        <div class="dropdown-divider"></div>
                    }
                    <form method="post" asp-page="/Clientes/Index" asp-page-handler="Eliminar" asp-route-id="@Model.Id"
                          data-confirm-title="¿Eliminar a @nombre?"
                          data-confirm="Se eliminará de forma permanente junto con sus relaciones con productos. Si solo dejó de ser cliente, márcalo como Inactivo."
                          data-confirm-ok="Eliminar" data-confirm-tone="danger">
                        <button type="submit" class="dropdown-item text-danger">@Iconos.Svg("trash") Eliminar</button>
                    </form>
                </div>
            </div>
        }
        <div class="gas-modal__footer-end">
            <button type="button" class="btn btn-gas-outline" data-bs-dismiss="modal">@Iconos.Svg("x") @(Model.PuedeGestionar ? "Cancelar" : "Cerrar")</button>
            @if (Model.PuedeGestionar)
            {
                <button type="submit" form="@formId" class="btn btn-gas">
                    @if (Model.EsNuevo)
                    {
                        @Iconos.Svg("check") <span>Crear cliente</span>
                    }
                    else
                    {
                        @Iconos.Svg("save") <span>Guardar cambios</span>
                    }
                </button>
            }
        </div>
    </div>
</div>
